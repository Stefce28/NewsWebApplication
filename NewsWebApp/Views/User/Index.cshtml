@model List<NewsWebApp.Shared.Models.User>

@{
    ViewData["Title"] = "Users";
}

<section class="page-header">
    <div>
        <span class="page-kicker">Автори</span>
        <h1>Users</h1>
        <p class="page-subtitle">Редакциски профили и авторски архиви.</p>
    </div>
</section>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>Нема внесени корисници.</p>
    </div>
}
else
{
    <section class="user-grid" aria-label="Корисници">
        @foreach (var user in Model)
        {
            <article class="user-card">
                <h2>@user.Name @user.Surname</h2>
                <p>@user.Email</p>
                <p>@user.Posts.Count статии</p>

                <div class="detail-actions">
                    <a class="read-more"
                       asp-controller="Articles"
                       asp-action="ByAuthor"
                       asp-route-authorId="@user.Id">
                        Articles
                    </a>

                    <a class="button-secondary"
                       asp-controller="User"
                       asp-action="Details"
                       asp-route-id="@user.Id">
                        Profile
                    </a>
                </div>
            </article>
        }
    </section>
}

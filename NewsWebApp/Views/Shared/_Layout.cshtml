@inject NewsWebApp.Services.IServices.IShockService ShockService
@{
    var shockStatus = ShockService.GetShockStatus();
    var shockPercent = shockStatus.CurrentPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var overloadBodyClass = shockStatus.ShouldAnimateOverload ? "shock-overload-pulse" : "";
}
<!DOCTYPE html>
<html lang="mk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Шокантно.мк</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="shock-level-@shockStatus.LevelClass @overloadBodyClass">

<header class="site-header">
    <div class="site-container nav-container">
        <a class="brand"
           asp-controller="Articles"
           asp-action="Index">
            Шокантно.мк
        </a>

        <nav class="main-nav" aria-label="Главна навигација">
            <a asp-controller="Articles"
               asp-action="Index">
                Home
            </a>

            <a asp-controller="Category"
               asp-action="Index">
                Categories
            </a>

            <a class="nav-highlight"
               asp-controller="Articles"
               asp-action="Create">
                New Article
            </a>
        </nav>

        <div class="account-nav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="account-name">@User.Identity.Name</span>
                <form class="logout-form"
                      asp-controller="Account"
                      asp-action="Logout"
                      method="post">
                    <button class="link-button" type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login">
                    Login
                </a>

                <a class="account-register"
                   asp-controller="Account"
                   asp-action="Register">
                    Register
                </a>
            }
        </div>
    </div>

    <section class="shock-meter shock-meter-@shockStatus.LevelClass" aria-label="Your shock level">
        <div class="site-container shock-meter-inner">
            <span class="shock-meter-label">YOUR SHOCK LEVEL</span>

            <div class="shock-meter-track"
                 role="progressbar"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="@shockStatus.CurrentPercentage">
                <div class="shock-meter-fill" style="width: @(shockPercent)%"></div>
            </div>

            <strong class="shock-meter-value">@(shockStatus.CurrentPercentage)%</strong>
        </div>
    </section>
</header>

<main class="site-container main-content">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="site-container">
        <p>© 2026 Шокантно.мк</p>
    </div>
</footer>

@if (shockStatus.IsInCooldown)
{
    <div class="shock-overload-overlay @(shockStatus.ShouldAnimateOverload ? "is-new" : "")"
         data-shock-overload
         data-cooldown-until="@shockStatus.CooldownEndsAtUnixMilliseconds"
         data-reset-url="@Url.Action("Reset", "Shock")">
        <div class="shock-overload-panel">
            <span class="shock-overload-title">SHOCK OVERLOAD</span>
            <p>@shockStatus.OverloadMessage</p>
            <p class="shock-overload-cooldown">
                Cooldown
                <strong data-shock-countdown>01:00</strong>
            </p>
        </div>
    </div>
}

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>
</html>

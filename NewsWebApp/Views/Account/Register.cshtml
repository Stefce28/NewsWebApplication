@{
    ViewData["Title"] = "Register";
    var postedName = ViewData.ModelState["name"]?.AttemptedValue ?? "";
    var postedSurname = ViewData.ModelState["surname"]?.AttemptedValue ?? "";
    var postedEmail = ViewData.ModelState["email"]?.AttemptedValue ?? "";
}

<section class="auth-shell">
    <div class="page-header">
        <div>
            <span class="page-kicker">Account</span>
            <h1>Register</h1>
        </div>
    </div>

    <form class="form-card" asp-action="Register" method="post">
        <div asp-validation-summary="All"></div>

        <div class="form-group">
            <label for="name">Name</label>
            <input id="name"
                   name="name"
                   value="@postedName"
                   required />
        </div>

        <div class="form-group">
            <label for="surname">Surname</label>
            <input id="surname"
                   name="surname"
                   value="@postedSurname"
                   required />
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input id="email"
                   type="email"
                   name="email"
                   value="@postedEmail"
                   required />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input id="password"
                   type="password"
                   name="password"
                   required />
        </div>

        <button class="button" type="submit">Register</button>
    </form>
</section>
